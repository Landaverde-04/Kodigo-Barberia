# Desarrollo local. Copiar a .env y completar los valores; no subir .env a Git.
DEBUG=True
SECRET_KEY=reemplazar-por-una-clave-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
NOMBRE_BARBERIA=Distrito Barber

# Crear previamente este usuario y esta base en PostgreSQL.
# Codificar caracteres reservados de la contraseña como URL (ejemplo: @ -> %40).
DATABASE_URL=postgresql://barberia:CAMBIAR_PASSWORD@127.0.0.1:5432/distrito_barber
